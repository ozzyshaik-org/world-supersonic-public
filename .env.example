# Copy to .env and fill in. Never commit .env.
# Values below are placeholders / local defaults, not real credentials.

# ---- ClickHouse (all services) ----
CLICKHOUSE_ADDR=127.0.0.1:9000            # rpc-gateway (native protocol)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<set-me>
CLICKHOUSE_DSN=clickhouse://127.0.0.1:9000/worldchain   # supersonic-api
CH_HOST=127.0.0.1                          # sgip, mev-detector (HTTP interface)
CH_PORT=8123
CH_DB=worldchain

# ---- rpc-gateway ----
# Required to enable POST /v1/auth/keys (sent as X-Admin-Token). If unset the
# endpoint returns 503. Generate with: openssl rand -hex 32
ADMIN_TOKEN=<generate-a-long-random-value>

# ---- supersonic-api / edge ----
WEB_DIR=./web
EDGE_IPC_SOCK=/tmp/supersonic.sock         # unix socket: supersonic-api -> edge

# ---- tank-engine ----
ETHERSCAN_API_KEY=<optional: used only by the cross-check auditor in remediator.rs>
# TANK_TRACE_GAP_MIN_BLOCK=0
# TANK_RAW_HEAL_ENQUEUE=
# RAW_HEAL_SKIP_TRACES=
# RAW_HEAL_REFILL_PRESENT=
# TANK_DISABLE_SEQUENCE_DRAIN=
# TANK_FENCE_WAIT_SECS=

# ---- exex (runs inside the op-reth process) ----
# EXEX_BYPASS_UNDER_BLOCK=0

# ---- mev-detector ----
# MEV_HOLE_MAX_WAIT_SEC=3600
# MEV_HOLE_HEALING_MAX_SEC=43200
# MEV_BLOCK_FAIL_MAX_SEC=3600
TELEGRAM_BOT_TOKEN=<optional>
TELEGRAM_CHAT_ID=<optional>
DISCORD_WEBHOOK_URL=<optional>
