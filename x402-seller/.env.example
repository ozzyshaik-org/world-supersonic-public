# Placeholders only — never commit real credentials.
# Arc Testnet / Circle Gateway (live calls are not used in the first checkpoint).

# Seller payTo address on Arc Testnet (0x...)
X402_PAY_TO=0xYOUR_SELLER_ADDRESS

# Arc Testnet CAIP-2 network id (Circle docs: eip155:5042002)
X402_NETWORK=eip155:5042002

# USDC token address on Arc Testnet (placeholder; confirm against Circle/Arc docs)
X402_USDC_ASSET=0x3600000000000000000000000000000000000000

# Gateway Wallet verifyingContract on Arc Testnet (placeholder)
X402_GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# Upstream Go API base URL (existing rpc-gateway). No hostname secrets in commits.
X402_UPSTREAM_BASE_URL=http://127.0.0.1:8081

# Server-side API key the seller holds for the Go API (never log or commit)
X402_UPSTREAM_API_KEY=replace-me

# Optional Circle API key for a future live BatchFacilitatorClient adapter
# CIRCLE_API_KEY=replace-me

# Experimental HTTP adapter (local only; not live Arc)
# X402_LISTEN_HOST=127.0.0.1
# X402_LISTEN_PORT=0
# X402_UPSTREAM_TIMEOUT_MS=5000
