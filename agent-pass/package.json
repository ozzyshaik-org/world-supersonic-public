{
  "name": "supersonic-agent-pass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental World ID Agent Pass human checkpoint for elevated Supersonic reads. No Arc payment integration.",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-reporter=spec test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "openid-client": "6.8.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
