# Server-side World IdP registration. Never expose the secret to browser code or logs.
WORLD_ISSUER=https://auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_CLIENT_AUTH_METHOD=client_secret_basic
WORLD_REDIRECT_URI=http://127.0.0.1:8097/auth/world/callback

# Exact public origin of this service; never inferred from request Host.
AGENT_PASS_PUBLIC_ORIGIN=http://127.0.0.1:8097
AGENT_PASS_LISTEN_HOST=127.0.0.1
AGENT_PASS_PORT=8097
AGENT_PASS_DB_PATH=./agent-pass.sqlite

# Local demo only. Set to 1 only for synthetic local accounts and a fake protected upstream.
AGENT_PASS_ENABLE_DEMO_SESSION=0
AGENT_PASS_DEMO_AGENT_ID=demo-agent
AGENT_PASS_DEMO_AGENT_CREDENTIAL=
AGENT_PASS_DEMO_ACCOUNT_ID=demo-account

# Fresh Orb-proof policy and bounded lifetimes (seconds).
AGENT_PASS_OPERATION_TTL_SECONDS=600
AGENT_PASS_ATTEMPT_TTL_SECONDS=300
AGENT_PASS_AUTH_FRESHNESS_SECONDS=600
AGENT_PASS_CLOCK_TOLERANCE_SECONDS=30
